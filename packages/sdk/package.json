{
  "name": "sunaba-sdk",
  "version": "0.1.1",
  "description": "High-level TypeScript SDK for AWS Lambda MicroVMs - sandboxes, exec, auth tokens, lifecycle",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./guest": {
      "types": "./dist/guest/index.d.ts",
      "import": "./dist/guest/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "guest": [
        "./dist/guest/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-lambda-microvms": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@types/ws": "^8.18.0",
    "fflate": "^0.8.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seike460/sunaba.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/seike460/sunaba#readme",
  "bugs": "https://github.com/seike460/sunaba/issues",
  "keywords": [
    "aws",
    "lambda",
    "microvms",
    "firecracker",
    "sandbox",
    "sdk",
    "typescript"
  ]
}
